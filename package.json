{
  "name": "internet-monitor-pro",
  "productName": "Internet Monitor Pro",
  "version": "1.0.0",
  "private": true,
  "description": "A Windows desktop app that continuously monitors internet connectivity, with alerts, history, and a system tray presence.",
  "author": "Internet Monitor Pro",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,TSC,ELECTRON -c blue,yellow,green \"npm:dev:vite\" \"npm:dev:tsc\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:tsc": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/main.js && cross-env NODE_ENV=development electron .",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:electron && node --test \"tests/*.test.js\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck:renderer && npm run build:renderer && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.internetmonitorpro.app",
    "productName": "Internet Monitor Pro",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/tray",
        "to": "assets/tray"
      },
      {
        "from": "assets/icons",
        "to": "assets/icons"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
